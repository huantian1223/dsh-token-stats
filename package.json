{
  "name": "dsh-token-stats",
  "version": "0.2.0",
  "description": "Token usage statistics for DeepSeek Harness: cumulative/today/peak tokens, streaks, a 12-month activity heatmap (daily/weekly/cumulative, range switch, day drill-down, CSV export), per-model/workspace breakdowns, live session badge and DeepSeek account balance. Host half records real provider usage from session logs; client half adds a Token Stats page to Web Settings.",
  "scripts": {
    "test": "vitest run"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "token",
    "usage",
    "statistics",
    "heatmap",
    "balance"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huantian1223/dsh-token-stats.git"
  },
  "author": "huantian1223",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "puppeteer-core": "^25.7.0",
    "vitest": "^4.1.10"
  }
}
